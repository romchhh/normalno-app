# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/db.js
/dist/db.js

# sqlite database
/prisma/*.db
/prisma/*.db-journal
*.db
*.db-journal

# data files (created dynamically)
/data/categories.json
/data/settings.json
/data/admin-users.json

# uploaded category images
/public/categories/

# telegram channel sync
/scripts/telegram_channel/.venv/
/scripts/telegram_channel/session*
/scripts/telegram_channel/*.session*
/scripts/telegram_channel/__pycache__/
**/__pycache__/
/public/uploads/cars/
/public/uploads/broadcast/
